import type { v1 } from "@google-cloud/vision";
import { createHash } from "node:crypto";
import {
  FieldValue,
  Timestamp,
} from "firebase-admin/firestore";
import {
  HttpsError,
  onCall,
} from "firebase-functions/v2/https";

import {
  db,
  ENFORCE_APP_CHECK,
} from "../core/runtime.js";
import {
  decodeHallmarkImagePayload,
  HallmarkImagePayloadError,
} from "./imagePayload.js";
import { recognizeHallmarkText } from "./recognition.js";
import { scoreHallmarkObservations } from "./scoring.js";
import type {
  HallmarkOcrObservation,
  HallmarkOcrStage,
} from "./scoring.js";
import { buildHallmarkImageVariants } from "./preprocessing.js";
import { detectNonGoldMaterialMark } from "./materialMarkers.js";
import {
  analyzeHallmarkWithAi,
  analyzeHallmarkWithAiMultiView,
} from "./aiHallmark.js";
import { decideAiHallmarkResult } from "./aiDecision.js";
import { analyzeVisibleHallmarkWithAi } from "./visibleMarkAi.js";
import { shouldUseHallmarkAiFallback } from "./aiFallbackPolicy.js";
import { buildHallmarkRotationVariants } from "./orientation.js";
import { resolveAiHallmarkConsensus } from "./aiConsensus.js";

let visionClientPromise: Promise<v1.ImageAnnotatorClient> | null = null;

async function getVisionClient(): Promise<v1.ImageAnnotatorClient> {
  if (!visionClientPromise) {
    visionClientPromise = import("@google-cloud/vision").then(
      ({ default: vision }) =>
        new vision.ImageAnnotatorClient()
    );
  }

  return visionClientPromise;
}

const GUEST_CALLS_PER_HOUR = 15;
const MEMBER_CALLS_PER_HOUR = 30;

function sha256(value: string): string {
  return createHash("sha256")
    .update(value)
    .digest("hex");
}

function currentHourKey(now = new Date()): string {
  return now
    .toISOString()
    .slice(0, 13)
    .replace(/[-T]/g, "");
}

async function enforceHallmarkOcrRateLimit(
  uid: string,
  ip: string,
  userAgent: string
): Promise<void> {
  const authenticated = Boolean(uid);
  const limit = authenticated
    ? MEMBER_CALLS_PER_HOUR
    : GUEST_CALLS_PER_HOUR;

  const actorSource = authenticated
    ? `uid:${uid}`
    : `guest:${ip || "unknown"}:${userAgent.slice(0, 180)}`;

  const actorHash = sha256(actorSource).slice(0, 40);
  const hourKey = currentHourKey();

  const ref = db().doc(
    `hallmarkOcrRateLimits/${hourKey}_${actorHash}`
  );

  await db().runTransaction(async (tx) => {
    const snap = await tx.get(ref);
    const previousCount = Number(snap.data()?.count || 0);

    if (
      !Number.isFinite(previousCount) ||
      previousCount < 0
    ) {
      throw new HttpsError(
        "internal",
        "호출 제한 상태를 확인하지 못했습니다."
      );
    }

    if (previousCount >= limit) {
      throw new HttpsError(
        "resource-exhausted",
        "각인 확인을 여러 번 시도했습니다. 잠시 후 다시 이용해 주세요."
      );
    }

    tx.set(
      ref,
      {
        count: previousCount + 1,
        authenticated,
        updatedAt: FieldValue.serverTimestamp(),

        // TTL 정책을 나중에 연결할 수 있도록 만료 시각만 기록합니다.
        // 원본 IP와 User-Agent는 저장하지 않습니다.
        expiresAt: Timestamp.fromMillis(
          Date.now() + 2 * 60 * 60 * 1000
        ),
      },
      { merge: true }
    );
  });
}

function statusFromRecognition(
  normalizedMark: string | null,
  candidateCount: number,
  requiresProductForm: boolean
):
  | "matched"
  | "needs_product_form"
  | "ambiguous"
  | "not_found" {
  if (candidateCount > 1) return "ambiguous";
  if (!normalizedMark) return "not_found";
  if (requiresProductForm) return "needs_product_form";
  return "matched";
}

export const analyzeGoldHallmark = onCall(
  {
    region: "asia-northeast3",
    enforceAppCheck: ENFORCE_APP_CHECK,
    timeoutSeconds: 60,
    memory: "512MiB",
    maxInstances: 10,
  },
  async (req) => {
    let image;

    try {
      image = decodeHallmarkImagePayload(req.data);
    } catch (error) {
      if (error instanceof HallmarkImagePayloadError) {
        const code =
          error.reason === "too_large"
            ? "resource-exhausted"
            : "invalid-argument";

        throw new HttpsError(code, error.message);
      }

      throw error;
    }

    const uid = String(req.auth?.uid || "").trim();
    const ip = String(req.rawRequest.ip || "").trim();
    const userAgent = String(
      req.rawRequest.get("user-agent") || ""
    ).trim();

    await enforceHallmarkOcrRateLimit(
      uid,
      ip,
      userAgent
    );

    /*
     * =====================================================
     * Gemini-primary hallmark reader
     * =====================================================
     *
     * 기본 경로:
     * 원본 + 180° + 90° + 270°를
     * Gemini 한 번의 요청으로 함께 판독합니다.
     *
     * Gemini는 각인 문자를 읽는 보조 눈 역할만 하며
     * 실제 금 순도를 인증하지 않습니다.
     *
     * 제품 선택/안전 규칙은 기존 서버 코드가 담당합니다.
     *
     * 현재 운영 경로는 Gemini visibleMark 판독을 사용하며,
     * 오래된 Vision-first 경로는 최종 정리에서 제거합니다.
     */
    const useGeminiPrimary =
      process.env.HALLMARK_GEMINI_PRIMARY !== "0";

    if (useGeminiPrimary) {

      const geminiStartedAt =
        Date.now();

      try {

        /*
         * Gemini-primary 기본 경로는 최대한 단순하게 유지합니다.
         *
         * 카메라가 촬영한 원본 사진 한 장을
         * 가공하지 않고 Gemini에 그대로 전달합니다.
         *
         * 회전 / 크롭 / 확대 / 대비보정 / Vision OCR은
         * 기본 판독 경로에서 사용하지 않습니다.
         */
        const aiResult =
          await analyzeVisibleHallmarkWithAi({
            bytes:
              image.bytes,

            mimeType:
              image.mimeType,
          });


        /*
         * AI 결과를 그대로 제품 선택으로 사용하지 않고
         * 기존 deterministic decision 규칙을 거칩니다.
         *
         * 예:
         * gold_18k -> 18K 후보
         * silver_925 -> 금 종류 선택 금지
         * platinum_950 -> 금 종류 선택 금지
         * plated -> 실금 자동판단 금지
         * low/unreadable -> 후보 없음
         * 999/999.9/24K -> 제품 형태 자동선택 금지
         */
        const decision =
          decideAiHallmarkResult(
            aiResult
          );

        const goldAccepted =
          Boolean(
            decision.accepted &&
            decision.material === "gold"
          );

        const suggestedMark =
          goldAccepted
            ? decision.suggestedMark
            : null;

        const suggestedLabel =
          goldAccepted
            ? decision.suggestedLabel
            : null;

        const suggestedProductId =
          goldAccepted
            ? decision.suggestedProductId
            : null;

        const requiresProductForm =
          Boolean(
            goldAccepted &&
            decision.requiresProductForm
          );

        const elapsedMs =
          Date.now() -
          geminiStartedAt;


        /*
         * 이미지와 AI 원문은 절대 로그에 기록하지 않습니다.
         */
        console.info(
          "[analyzeGoldHallmark] Gemini primary result",
          {
            visibleMark:
              aiResult.visibleMark,

            modifier:
              aiResult.modifier,

            material:
              aiResult.material,

            family:
              aiResult.family,

            confidence:
              aiResult.confidence,

            partial:
              aiResult.partial,

            accepted:
              decision.accepted,

            requiresProductForm,

            elapsedMs,

            imageBytes:
              image.bytes.length,

            viewCount:
              1,

            inputMode:
              "original",

            mimeType:
              image.mimeType,
          }
        );


        return {
          ok: true,

          /*
           * AI 결과는 deterministic OCR 확정값과 구분합니다.
           * 기존 클라이언트는 status 자체로
           * 후보 버튼을 결정하지 않습니다.
           */
          status:
            requiresProductForm
              ? "needs_product_form"
              : "not_found",

          textDetected:
            false,

          normalizedMark:
            null,

          candidates:
            [],

          matchConfidence:
            "low",

          requiresProductForm,

          /*
           * Gemini 결과는 자동 recommendation으로
           * 절대 승격하지 않습니다.
           */
          recommendationProductId:
            null,

          materialMarker:
            null,

          materialNormalizedMark:
            null,

          materialConflict:
            false,

          suggestedMark,

          suggestedLabel,

          suggestedProductId,

          suggestionConfidence:
            goldAccepted
              ? aiResult.confidence
              : null,

          aiUsed:
            true,

          aiMaterial:
            aiResult.material,

          aiFamily:
            aiResult.family,

          aiConfidence:
            aiResult.confidence,

          aiPartial:
            aiResult.partial,

          geminiPrimary:
            true,

          processingMs:
            elapsedMs,

          message:
            decision.message,
        };

      }
      catch (error) {

        const elapsedMs =
          Date.now() -
          geminiStartedAt;

        const aiError =
          error as {
            name?: unknown;
            message?: unknown;
            code?: unknown;
            status?: unknown;
          };

        const safeErrorMessage =
          typeof aiError?.message === "string"
            ? aiError.message
                .replace(/[\r\n]+/g, " ")
                .slice(0, 500)
            : null;

        /*
         * Gemini 장애 시 오래 걸리는 Vision 파이프라인을
         * 자동 실행하지 않습니다.
         *
         * 사용자는 즉시 직접 선택하거나
         * 다시 촬영할 수 있습니다.
         */
        console.warn(
          "[analyzeGoldHallmark] Gemini primary failed",
          {
            errorName:
              typeof aiError?.name === "string"
                ? aiError.name
                : "unknown",

            errorCode:
              typeof aiError?.code === "string" ||
              typeof aiError?.code === "number"
                ? String(aiError.code)
                : null,

            errorStatus:
              typeof aiError?.status === "string" ||
              typeof aiError?.status === "number"
                ? String(aiError.status)
                : null,

            errorMessage:
              safeErrorMessage,

            elapsedMs,
          }
        );


        return {
          ok: true,
          status: "not_found",
          textDetected: false,
          normalizedMark: null,
          candidates: [],
          matchConfidence: "low",
          requiresProductForm: false,
          recommendationProductId: null,
          materialMarker: null,
          materialNormalizedMark: null,
          materialConflict: false,
          suggestedMark: null,
          suggestedLabel: null,
          suggestedProductId: null,
          suggestionConfidence: null,
          aiUsed: true,
          aiMaterial: null,
          aiFamily: null,
          aiConfidence: null,
          aiPartial: null,
          geminiPrimary: true,
          processingMs: elapsedMs,
          message:
            "각인 확인에 일시적으로 실패했습니다. 다시 촬영하거나 금 종류를 직접 선택해 주세요.",
        };
      }
    }

    /*
     * 비상 롤백용 기존 Vision-first 코드.
     *
     * HALLMARK_GEMINI_PRIMARY=0 일 때만 실행됩니다.
     */
    const ocrTexts: string[] = [];

    const ocrObservations:
      HallmarkOcrObservation[] = [];

    let ocrAttempts = 0;

    let recognition = recognizeHallmarkText("");
    let status = statusFromRecognition(
      recognition.normalizedMark,
      recognition.candidates.length,
      recognition.requiresProductForm
    );

    try {
      const visionClient = await getVisionClient();

      const readOcr = async (
        stage: HallmarkOcrStage,
        bytes: Buffer
      ): Promise<void> => {
        ocrAttempts += 1;

        const [result] = await visionClient.annotateImage({
          image: {
            content: bytes,
          },
          features: [
            {
              type: "TEXT_DETECTION",
              model: "builtin/latest",
            },
          ],
        });

        const text = String(
          result.textAnnotations?.[0]?.description ||
          result.fullTextAnnotation?.text ||
          ""
        ).trim();

        ocrObservations.push({
          stage,
          text,
        });

        if (text) {
          ocrTexts.push(text);
        }

        recognition = recognizeHallmarkText(
          ocrTexts.join("\n")
        );

        status = statusFromRecognition(
          recognition.normalizedMark,
          recognition.candidates.length,
          recognition.requiresProductForm
        );
      };

      // 1차: 원본 이미지를 그대로 OCR합니다.
      await readOcr(
        "original",
        image.bytes
      );

      // 원본에서 지원 각인을 찾지 못한 경우에만
      // 금속 각인용 전처리를 추가로 사용합니다.
      if (status === "not_found") {
        const variants =
          await buildHallmarkImageVariants(image.bytes);

        const contrast = variants.find(
          (variant) =>
            variant.name === "metal-contrast"
        );

        const threshold = variants.find(
          (variant) =>
            variant.name === "metal-threshold"
        );

        // 2차: 명암·선명도 강화
        if (contrast) {
          await readOcr(
            "metal-contrast",
            contrast.bytes
          );
        }

        // 정확 판독이 되지 않았지만 범용 점수 엔진에서
        // 충분한 사용자 확인 후보가 나온 경우에는
        // 불필요한 세 번째 Vision 호출을 생략합니다.
        const provisionalScoring =
          status === "not_found"
            ? scoreHallmarkObservations(
                ocrObservations
              )
            : null;

        const needsThreshold =
          status === "not_found" &&
          !provisionalScoring?.suggestion;

        // 3차: 강한 명암 분리
        if (
          needsThreshold &&
          threshold
        ) {
          await readOcr(
            "metal-threshold",
            threshold.bytes
          );
        }
      }
    } catch (error) {
      const code = String(
        (error as { code?: unknown })?.code || ""
      );

      console.error(
        "[analyzeGoldHallmark] Vision OCR failed",
        {
          code,
          authenticated: Boolean(uid),
          imageBytes: image.bytes.length,
          mimeType: image.mimeType,
          ocrAttempts,
        }
      );

      throw new HttpsError(
        "unavailable",
        "각인 판독을 완료하지 못했습니다. 잠시 후 다시 시도해 주세요."
      );
    }

    const ocrText = ocrTexts.join("\n");

    /*
     * 은·백금 표시를 금 fuzzy scoring보다 먼저 확인합니다.
     *
     * 예:
     * - 925 / S925 / STERLING
     * - PT950 / PLATINUM 950
     *
     * 금 각인과 비금 각인이 서로 다른 OCR 단계에서 동시에
     * 검출되면 안전을 위해 충돌로 처리하고 자동 추천하지 않습니다.
     */
    const materialDetection =
      detectNonGoldMaterialMark(
        ocrText
      );

    const goldMarkDetected =
      Boolean(
        recognition.normalizedMark ||
        recognition.candidates.length
      );

    const materialConflict =
      materialDetection.conflict ||
      Boolean(
        materialDetection.marker &&
        goldMarkDetected
      );

    const nonGoldMaterialDetected =
      Boolean(
        materialDetection.marker
      );

    // 정확한 각인 판정에 실패했고,
    // 은·백금 표시나 재질 충돌도 없는 경우에만
    // 범용 fuzzy scoring을 수행합니다.
    const scoringDecision =
      status === "not_found" &&
      !nonGoldMaterialDetected &&
      !materialConflict
        ? scoreHallmarkObservations(
            ocrObservations
          )
        : null;

    const suggestion =
      !nonGoldMaterialDetected &&
      !materialConflict
        ? (
            scoringDecision?.suggestion ||
            null
          )
        : null;

    /*
     * OCR에서 이미 도금/금장 표시를 발견했다면
     * AI로 다시 금 후보를 만들지 않습니다.
     */
    const platedMarkerDetected =
      scoringDecision?.reason ===
      "non_solid_marker";

    /*
     * AI는 마지막 보조 판독 단계입니다.
     *
     * 실행 조건:
     * - 정확 OCR 실패
     * - 기존 fuzzy 후보도 없음
     * - 은/백금 표시 없음
     * - 재질 충돌 없음
     * - 도금/금장 표시 없음
     *
     * 이미지와 AI 원문 응답은 로그에 저장하지 않습니다.
     */
    /*
     * AI 1차 판독 결과.
     * 이 결과만으로는 사용자에게 재질/금 종류를 제안하지 않습니다.
     */
    let aiInitialResult:
      Awaited<
        ReturnType<
          typeof analyzeHallmarkWithAi
        >
      > | null = null;

    /*
     * 동일 사진을 원본 / 180 / 90 / 270도로 보여 주는
     * 2차 교차검증 결과입니다.
     */
    let aiVerificationResult:
      Awaited<
        ReturnType<
          typeof analyzeHallmarkWithAiMultiView
        >
      > | null = null;

    /*
     * 사용자 응답에 사용할 AI 결과는
     * 교차검증 합의가 완료된 결과만 저장합니다.
     */
    let aiResult:
      Awaited<
        ReturnType<
          typeof analyzeHallmarkWithAi
        >
      > | null = null;

    let aiDecision:
      ReturnType<
        typeof decideAiHallmarkResult
      > | null = null;

    let aiConsensusReason:
      | "agreed"
      | "initial_not_eligible"
      | "verification_not_eligible"
      | "family_mismatch"
      | null = null;

    let aiFallbackFailed = false;

    const shouldUseAi =
      shouldUseHallmarkAiFallback({
        status,
        hasSuggestion:
          Boolean(suggestion),
        nonGoldMaterialDetected,
        materialConflict,
        platedMarkerDetected,
        scoringReason:
          scoringDecision?.reason ||
          null,
      });

    if (shouldUseAi) {
      try {

        /*
         * 1차: 원본 사진 한 장으로 판독합니다.
         */
        aiInitialResult =
          await analyzeHallmarkWithAi({
            bytes: image.bytes,
            mimeType: image.mimeType,
          });

        const initialDecision =
          decideAiHallmarkResult(
            aiInitialResult
          );

        /*
         * low confidence / unreadable / other 등은
         * 2차 AI 호출까지 하지 않습니다.
         */
        if (!initialDecision.accepted) {

          aiConsensusReason =
            "initial_not_eligible";

          aiDecision =
            initialDecision;

        }
        else {

          /*
           * 같은 사진의 회전본을 만듭니다.
           * 동일 사진에서 파생된 이미지이므로
           * 독립적인 증거 수로 계산하지 않습니다.
           */
          const rotationVariants =
            await buildHallmarkRotationVariants(
              image.bytes
            );

          if (
            rotationVariants.length !== 3
          ) {
            throw new Error(
              "hallmark-ai-rotation-count-invalid"
            );
          }

          /*
           * 2차:
           * 원본 + 180 + 90 + 270도를
           * 하나의 요청에서 함께 확인합니다.
           */
          aiVerificationResult =
            await analyzeHallmarkWithAiMultiView({
              images: [
                {
                  bytes:
                    image.bytes,

                  mimeType:
                    image.mimeType,
                },

                ...rotationVariants.map(
                  (variant) => ({
                    bytes:
                      variant.bytes,

                    mimeType:
                      "image/png" as const,
                  })
                ),
              ],
            });

          /*
           * 1차와 2차의 material + family가
           * 정확히 같아야 합의로 인정합니다.
           */
          const consensus =
            resolveAiHallmarkConsensus(
              aiInitialResult,
              aiVerificationResult
            );

          aiConsensusReason =
            consensus.reason;

          if (
            consensus.accepted &&
            consensus.result
          ) {

            aiResult =
              consensus.result;

            aiDecision =
              decideAiHallmarkResult(
                consensus.result
              );

          }
          else {

            /*
             * 예:
             * 1차 18K / 2차 925
             * 1차 925 / 2차 unreadable
             *
             * 어느 쪽도 사용자에게 제안하지 않습니다.
             */
            aiResult = null;

            aiDecision = {
              accepted: false,
              material: "unreadable",
              suggestedMark: null,
              suggestedLabel: null,
              suggestedProductId: null,
              requiresProductForm: false,
              message:
                "각인 판독 결과가 일관되지 않아 재질이나 종류를 확실하게 안내하기 어렵습니다. 다시 촬영하거나 실제 각인을 직접 확인해 주세요.",
            };
          }
        }

      } catch (error) {

        /*
         * 검증 과정 어느 단계에서 오류가 나도
         * 1차 AI 결과만으로 사용자에게 제안하지 않습니다.
         */
        aiFallbackFailed = true;
        aiResult = null;
        aiDecision = null;

        const aiError =
          error as {
            name?: unknown;
            message?: unknown;
            code?: unknown;
            status?: unknown;
          };

        const safeErrorMessage =
          typeof aiError?.message === "string"
            ? aiError.message
                .replace(/[\\r\\n]+/g, " ")
                .slice(0, 800)
            : null;

        console.warn(
          "[analyzeGoldHallmark] AI fallback failed",
          {
            errorName:
              typeof aiError?.name === "string"
                ? aiError.name
                : "unknown",

            errorCode:
              typeof aiError?.code === "string" ||
              typeof aiError?.code === "number"
                ? String(aiError.code)
                : null,

            errorStatus:
              typeof aiError?.status === "string" ||
              typeof aiError?.status === "number"
                ? String(aiError.status)
                : null,

            errorMessage:
              safeErrorMessage,
          }
        );
      }
    }

    const aiGoldAccepted =
      Boolean(
        aiDecision?.accepted &&
        aiDecision.material === "gold"
      );

    /*
     * AI가 제안한 금 종류는 recommendation으로 승격하지 않습니다.
     * 반드시 suggested 계열로만 내려 보내 사용자가 직접 확인합니다.
     */
    const finalSuggestedMark =
      suggestion?.normalizedMark ||
      (
        aiGoldAccepted
          ? aiDecision?.suggestedMark
          : null
      ) ||
      null;

    const finalSuggestedLabel =
      suggestion?.label ||
      (
        aiGoldAccepted
          ? aiDecision?.suggestedLabel
          : null
      ) ||
      null;

    const finalSuggestedProductId =
      suggestion?.productId ||
      (
        aiGoldAccepted
          ? aiDecision?.suggestedProductId
          : null
      ) ||
      null;

    const finalSuggestionConfidence =
      suggestion?.confidence ||
      (
        aiGoldAccepted
          ? aiResult?.confidence
          : null
      ) ||
      null;

    const finalRequiresProductForm =
      recognition.requiresProductForm ||
      Boolean(
        aiGoldAccepted &&
        aiDecision?.requiresProductForm
      );

    /*
     * 비금 재질 또는 재질 충돌이 감지되면
     * 기존 금 추천값도 클라이언트에 전달하지 않습니다.
     *
     * AI 금 후보는 이 값에 절대로 들어가지 않습니다.
     */
    const safeRecommendationProductId =
      !nonGoldMaterialDetected &&
      !materialConflict
        ? recognition.recommendationProductId
        : null;

    /*
     * 사용자에게 보여 주는 문구는 판독 신뢰도에 따라 구분합니다.
     * 카메라는 금 순도가 아니라 제품에 새겨진 표시를 읽는 보조 기능입니다.
     */
    const resultMessage =
      materialConflict
        ? "서로 다른 재질의 각인 표시가 함께 감지되었습니다. 금 종류를 자동으로 선택하지 않습니다. 실제 각인을 다시 확인해 주세요."
        : materialDetection.marker === "silver_925"
          ? "925 계열 각인이 확인되었습니다. 일반적으로 은 제품에 사용되는 표시입니다. 금 종류로 자동 선택하지 않습니다."
          : materialDetection.marker === "platinum_950"
            ? "PT950 계열 각인이 확인되었습니다. 일반적으로 백금 제품에 사용되는 표시입니다. 금 종류로 자동 선택하지 않습니다."
            : suggestion
              ? `${suggestion.label} 각인일 가능성이 있습니다. 각인이 선명하지 않아 확정할 수 없습니다. 실제 각인을 확인한 뒤 선택해 주세요.`
              : aiDecision
                ? aiDecision.message
        : (
            status === "ambiguous" ||
            scoringDecision?.reason === "ambiguous"
          )
          ? "각인을 명확히 구분하지 못했습니다. 금 종류를 직접 선택하거나 다시 촬영해 주세요."
          : scoringDecision?.reason ===
              "insufficient_evidence"
            ? "각인 일부가 보이지만 확실하게 확인되지 않았습니다. 빛 반사를 줄여 다시 촬영하거나 금 종류를 직접 선택해 주세요."
            : (
                status === "not_found" &&
                !ocrText
              )
              ? "각인을 읽지 못했습니다. 빛 반사를 줄이고 각인을 중앙에 크게 맞춰 다시 촬영해 주세요."
              : (
                  status === "not_found" &&
                  scoringDecision?.reason ===
                    "no_candidate"
                )
                ? "각인을 명확히 읽지 못했습니다. 빛 반사를 줄여 다시 촬영하거나 금 종류를 직접 선택해 주세요."
                : (
                    recognition.confidence ===
                      "medium" &&
                    recognition.normalizedMark
                  )
                  ? `${recognition.normalizedMark} 각인으로 보입니다. 촬영 상태에 따라 오인식될 수 있으니 실제 각인을 확인한 뒤 선택해 주세요.`
                  : recognition.message;

    // 사진과 OCR 원문은 로그에 남기지 않습니다.
    // 성공/실패 여부를 비교할 수 있도록 비식별 판독 메타데이터만 기록합니다.
    console.info(
      "[analyzeGoldHallmark] OCR result",
      {
        status,
        ocrAttempts,

        textDetected:
          Boolean(ocrText),

        normalizedMark:
          recognition.normalizedMark ||
          null,

        matchConfidence:
          recognition.confidence ||
          null,

        scoringReason:
          scoringDecision?.reason ||
          null,

        scoringTopScore:
          scoringDecision?.topScore ??
          null,

        scoringMargin:
          scoringDecision?.margin ??
          null,

        scoringSummary:
          scoringDecision?.ranking
            .slice(0, 4)
            .map(
              (item) =>
                `${item.normalizedMark}:${item.score}:${item.evidenceStages}`
            )
            .join("|") ||
          "-",

        suggestedMark:
          suggestion?.normalizedMark ||
          null,

        materialMarker:
          materialDetection.marker ||
          null,

        materialConflict,

        aiUsed:
          shouldUseAi,

        aiInitialMaterial:
          aiInitialResult?.material ||
          null,

        aiInitialFamily:
          aiInitialResult?.family ||
          null,

        aiInitialConfidence:
          aiInitialResult?.confidence ||
          null,

        aiVerificationUsed:
          Boolean(
            aiVerificationResult
          ),

        aiVerificationMaterial:
          aiVerificationResult?.material ||
          null,

        aiVerificationFamily:
          aiVerificationResult?.family ||
          null,

        aiVerificationConfidence:
          aiVerificationResult?.confidence ||
          null,

        aiConsensusReason,

        aiAccepted:
          aiDecision?.accepted ??
          false,

        aiMaterial:
          aiResult?.material ||
          null,

        aiFamily:
          aiResult?.family ||
          null,

        aiConfidence:
          aiResult?.confidence ||
          null,

        aiPartial:
          aiResult?.partial ??
          null,

        aiFallbackFailed,

        usedPreprocessing:
          ocrAttempts > 1,

        imageBytes:
          image.bytes.length,

        mimeType:
          image.mimeType,
      }
    );

    return {
      ok: true,
      status,
      textDetected: Boolean(ocrText),
      normalizedMark: recognition.normalizedMark,
      candidates: recognition.candidates,
      matchConfidence: recognition.confidence,
      requiresProductForm:
        finalRequiresProductForm,
      recommendationProductId:
        safeRecommendationProductId,

      materialMarker:
        materialDetection.marker,

      materialNormalizedMark:
        materialDetection.normalizedMark,

      materialConflict,

      suggestedMark:
        finalSuggestedMark,
      suggestedLabel:
        finalSuggestedLabel,
      suggestedProductId:
        finalSuggestedProductId,
      suggestionConfidence:
        finalSuggestionConfidence,

      aiUsed:
        shouldUseAi,

      aiMaterial:
        aiResult?.material || null,

      aiFamily:
        aiResult?.family || null,

      message: resultMessage,
    };
  }
);