rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ───────── 공통 헬퍼 ───────── */
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
             (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    // 업로드(생성/갱신) 파일 제약: 15MB 이하 + 이미지 MIME만 허용
    // ※ delete 요청에는 request.resource가 없으므로 여기서 검사하지 않습니다.
    function isValidImageUpload() {
      return request.resource != null
             && request.resource.size <= 15 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    function isValidPrivateUpload() {
      return request.resource != null
             && request.resource.size <= 10 * 1024 * 1024
             && (request.resource.contentType.matches('image/.*')
                 || request.resource.contentType == 'application/pdf');
    }

    /* ───────── 상품 이미지 ─────────
       - 공개 읽기
       - 업로드/갱신: 업로더 본인(경로 uid) 또는 관리자만 + 이미지 제약
       - 삭제: 업로더 본인(경로 uid) 또는 관리자만 (파일 제약 없음)
    */
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow write:  if (isOwner(uid) || isAdmin()) && isValidImageUpload();
      allow delete: if (isOwner(uid) || isAdmin());
    }

    /* ───────── (레거시) productImages/{uid}/... ─────────
       - 공개 읽기
       - anonymous 경로 차단
       - 업로드/갱신: 소유자 또는 관리자 + 이미지 제약
       - 삭제: 소유자 또는 관리자
    */
    match /productImages/{uid}/{allPaths=**} {
      allow read: if true;
      allow write:  if uid != "anonymous" && (isOwner(uid) || isAdmin()) && isValidImageUpload();
      allow delete: if uid != "anonymous" && (isOwner(uid) || isAdmin());
    }

    /* ───────── 프로필/아바타 ─────────
       - 공개 읽기
       - 업로드/갱신: 본인 또는 관리자 + 이미지 제약
       - 삭제: 본인 또는 관리자
    */
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write:  if (isOwner(uid) || isAdmin()) && isValidImageUpload();
      allow delete: if (isOwner(uid) || isAdmin());
    }

    /* ───────── 프로필 사진(현 경로: profilePhotos/{uid}/...) ─────────
       - 공개 읽기
       - 업로드/갱신: 본인 또는 관리자 + 이미지 제약
       - 삭제: 본인 또는 관리자
    */
    match /profilePhotos/{uid}/{allPaths=**} {
      allow read: if true;
      allow write:  if (isOwner(uid) || isAdmin()) && isValidImageUpload();
      allow delete: if (isOwner(uid) || isAdmin());
    }

    /* ───────── 개인 전용 영역 ─────────
       - 본인/관리자만 읽기/쓰기/삭제
       - 이미지 또는 PDF, 파일당 10MB 이하
       - 영수증/임시 업로드 등 비공개 용도
    */
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && isValidPrivateUpload();
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* ───────── 본인확인 서류(비공개) ───────── */
    match /accountVerifications/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* ───────── 채팅 이미지 ───────── */
    match /chatImages/{chatId}/{allPaths=**} {
      function chatData() {
        return firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
      }
      function isChatParticipant() {
        let chat = chatData();
        return signedIn() && (
          (chat.participants is list && request.auth.uid in chat.participants) ||
          (chat.participantsMap is map && chat.participantsMap[request.auth.uid] == true)
        );
      }

      allow read: if isAdmin() || isChatParticipant();
      allow create, update: if isChatParticipant() && isValidImageUpload();
      allow delete: if isAdmin() || isChatParticipant();
    }

    /* ───────── 기본 거부 ───────── */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
