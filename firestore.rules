rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.admin == true || request.auth.token.superAdmin == true);
    }

    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'admin', 'superAdmin', 'bonus', 'bonusGoldMilliGrams',
        'bonusGoldG', 'bonusGoldUpdatedAt', 'roleUpdatedAt', 'roleUpdatedBy'
      ]);
    }

    function userClientFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'name', 'nickname', 'email', 'phone', 'profileImage',
        'createdAt', 'updatedAt', 'consents',
        'notificationPreferences', 'notificationPreferencesUpdatedAt',
        'marketingFcmToken', 'marketingFcmBrowser', 'marketingFcmTokenUpdatedAt',
        'fcmTokens', 'nativeFcmTokens', 'pushTokensUpdatedAt',
        'myExchangesLastSeenAt'
      ]);
    }

    function allowedUserCreateFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'displayName', 'name', 'nickname', 'email', 'phone', 'profileImage',
        'createdAt', 'updatedAt', 'consents',
        'notificationPreferences', 'notificationPreferencesUpdatedAt',
        'marketingFcmToken', 'marketingFcmBrowser', 'marketingFcmTokenUpdatedAt',
        'fcmTokens', 'nativeFcmTokens', 'pushTokensUpdatedAt',
        'myExchangesLastSeenAt'
      ]);
    }

    match /appConfig/{docId} {
      // 고객 화면에 필요한 공개 설정만 읽을 수 있습니다.
      allow read: if docId in ['goldRates', 'reservedSlots', 'bookingAvailability'];
      // 환산율·예약 슬롯·예약 가능일은 검증·감사 기능이 있는 서버 함수로만 변경합니다.
      allow write: if false;
    }

    match /goldRateHistory/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 홈페이지 공개 시세(current), KRX 참고 시세(pending)
    match /goldPrices/{docId} {
      allow read: if docId == 'current' || isAdmin();
      allow create, update: if isAdmin() && docId == 'current';
      allow delete: if false;
    }

    // 금시세 공개 설정. 금교환 적용률(appConfig/goldRates)과 완전히 별개입니다.
    match /goldPricePublic/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId == 'config'
        && request.resource.data.keys().hasOnly([
          'enabled',
          'display14kSellPrice',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.display14kSellPrice is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 기존 KRX 참고 조회용 설정은 유지합니다.
    match /goldPriceSettings/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && docId == 'current'
        && request.resource.data.keys().hasOnly([
          'enabled',
          'publishMode',
          'roundingUnit',
          'pureGoldBuy',
          'pureGoldSell',
          'gold18kBuy',
          'gold14kBuy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.publishMode in ['approval', 'auto']
        && request.resource.data.roundingUnit in [1, 10, 100, 1000, 10000]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 날짜별 최종 시세: 홈페이지 과거 조회를 위해 공개 읽기, 관리자만 쓰기
    match /goldPriceHistory/{historyId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // KRX 원본 참고 이력은 관리자만 확인
    match /goldPriceKrxHistory/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && allowedUserCreateFieldsOnly();
      allow update: if isOwner(uid) && protectedUserFieldsUnchanged() && userClientFieldsOnly();
      allow delete: if false;

      match /ledger/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      match /promotions/{promotionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /profiles/{uid} {
      // 공개 회원 디렉터리를 운영하지 않으므로 본인/관리자만 조회합니다.
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'displayName', 'photoURL'
        ]);
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL'
        ]);
      allow delete: if false;
    }

    match /nicknames/{nickname} {
      // 중복 확인/선점은 서버 callable로만 처리합니다.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if false;
        allow update: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
          request.resource.data.read == true &&
          (!('readAt' in request.resource.data) || request.resource.data.readAt == request.time);
      }
    }

    match /goldExchangeGroups/{groupId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /goldExchanges/{exchangeId} {
      allow read: if isAdmin() ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.participants is list && request.auth.uid in resource.data.participants)
        ));
      allow write: if false;
    }

    match /bonusGoldRedemptionRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /verifiedGoldExchangeReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /goldExchangeReviewClaims/{exchangeId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          get(/databases/$(database)/documents/goldExchanges/$(exchangeId)).data.userId
            == request.auth.uid);
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      function validTicket(data) {
        return data.keys().hasOnly([
          'title', 'content', 'category', 'authorId', 'authorNickname',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
        data.category == 'inquiry' &&
        data.authorId == request.auth.uid &&
        data.authorNickname is string && data.authorNickname.size() <= 80 &&
        data.status == 'open' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
      }

      allow read: if isAdmin() ||
        (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && validTicket(request.resource.data);
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'content', 'updatedAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000 &&
        request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin() || (
        signedIn() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'open'
      );
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
