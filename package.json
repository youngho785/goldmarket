{
  "name": "goldmarket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo-pages.mjs",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "preview": "vite preview",
    "// 설명": "빌드 전 sitemap/rss 생성 + 빌드 후 경로별 SEO HTML 생성",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "gen:sitemap": "node scripts/generate-sitemap.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage \"npm --prefix tests/rules test\"",
    "test:app-check": "node scripts/test-app-check-policy.mjs",
    "test:ui-safety": "node scripts/test-ui-safety.mjs",
    "test:seo-guides": "node scripts/test-seo-guides.mjs",
    "app-check:status": "node scripts/app-check-status.mjs",
    "deploy": "firebase deploy --only hosting",
    "android:prepare": "npm run build && npx cap sync android",
    "test:monitoring": "node --test scripts/test-operational-monitoring.mjs functions/scripts/test-monitoring-security.mjs",
    "test:analytics": "node scripts/test-product-analytics.mjs",
    "test:ux-upgrade": "node scripts/test-ux-upgrade.mjs",
    "test:release": "node scripts/test-release-simple.mjs",
    "test:auth-safety": "node scripts/test-auth-core-safety.mjs",
    "test:smoke:setup": "npm --prefix tests/smoke run setup",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:smoke:headed": "node scripts/run-smoke.mjs --headed",
    "test:mobile": "node scripts/run-mobile-smoke.mjs",
    "test:mobile:headed": "node scripts/run-mobile-smoke.mjs --headed"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.541.0",
    "react": "^19.1.1",
    "react-content-loader": "^7.1.1",
    "react-datepicker": "^8.7.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.4.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2"
  }
}
