# Firebase 웹 앱 공개 설정
# Firebase Console > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성의 값을 입력합니다.
# 이 값들은 웹 앱 식별용 공개 설정이며 서비스 계정 비밀키와는 다릅니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# Firebase Console > App Check에서 웹 앱을 등록한 뒤 발급된 사이트 키를 입력하세요.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# 로컬 에뮬레이터 테스트에서만 사용합니다. 운영 환경에는 설정하지 마세요.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# 관리자 MFA 등록 및 로그인 확인 후 true로 전환합니다.
VITE_REQUIRE_ADMIN_MFA=false

# Firebase Cloud Messaging 웹 푸시 공개 키
VITE_VAPID_KEY=
